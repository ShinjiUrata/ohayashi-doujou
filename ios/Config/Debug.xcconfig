// お囃子道場 — Debug ビルド設定

#include "Base.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = com.zembrem.ohayashidoujou.dev

// Phase 4 で下記に実際の Cloud Run / GCS URL を設定
// API_BASE_URL = https:/$()/api-<dev-hash>.asia-northeast1.run.app
// CHARTS_BASE_URL = https:/$()/storage.googleapis.com/ohayashi-charts-dev

// Debug ビルド向けフラグ
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) DEBUG
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) DEBUG=1
